{
  "name": "edumentor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixtures:generate": "node scripts/make-fixtures.mjs",
    "check:bundle": "node scripts/check-no-secrets-in-client.mjs",
    "check:persistence": "node scripts/check-no-server-persistence.mjs",
    "check-contrast": "node scripts/check-contrast.mjs",
    "check:colors": "node scripts/check-hardcoded-colors.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run check:bundle && npm run check:persistence && npm run check-contrast && npm run check:colors && npm run build && npm run test:e2e",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@huggingface/transformers": "^4.3.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.2",
    "lucide-react": "^0.525.0",
    "next": "16.4.2",
    "pdfjs-dist": "4.10.38",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.67",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.10",
    "@tailwindcss/vite": "^4.1.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.30.1",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.5",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "pdf-lib": "1.17.1",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
