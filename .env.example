# Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or expose secrets in browser code.

# Required at runtime (server-only) — obtain from Google AI Studio
GEMINI_API_KEY=

# Gemini model to use (server-only)
GEMINI_MODEL=gemini-3.8-flash

# Optional: log level (debug | info | warn | error)
LOG_LEVEL=info
